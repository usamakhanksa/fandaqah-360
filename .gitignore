# internal documents (playbook, design references): never commit, never deploy
_internal/

# tooling
node_modules/
__pycache__/

# upload packages (tools/package-php.py)
_dist/

# the internal archive: kept on disk, never committed (it outgrew GitHub's 100 MB limit)
_internal.zip

# zip packages and exports (site uploads, archives): kept on disk, never committed; GitHub refuses files over 100 MB
*.zip

# server logs (logs/.htaccess keeps the folder private on the host)
logs/*.log

# server secrets (api/config.local.php): on the host and in the upload package, never in git
api/config.local.php
